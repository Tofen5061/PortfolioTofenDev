---
import '../styles/global.css';
import { PROFILES, type ProfileKey } from '../data/site';

interface Props {
  profile: ProfileKey;
}

const { profile } = Astro.props;
const { pageTitle, metaDescription } = PROFILES[profile];
---

<!doctype html>
<html lang="es" data-theme={profile}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta name="theme-color" content="#05080f" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="bg-fx" aria-hidden="true">
      <div class="aurora aurora-1"></div>
      <div class="aurora aurora-2"></div>
      <div class="aurora aurora-3"></div>
      <div class="grid-lines"></div>
      <div class="noise"></div>
    </div>

    <slot />

    <script>
      // Aparición de los bloques al entrar en pantalla
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      // Brillo que sigue al cursor en las tarjetas
      document.addEventListener('pointermove', (event) => {
        const card = (event.target as Element).closest?.<HTMLElement>('.spot');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        card.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    </script>
  </body>
</html>
