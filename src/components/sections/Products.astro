---
import Icon from '../Icon.astro';
import SectionTitle from '../SectionTitle.astro';
import VideoFrame from '../VideoFrame.astro';
import { ERP, waLink } from '../../data/site';
---

<section id="productos" class="only-tofen section">
  <div class="container-x">
    <SectionTitle
      eyebrow="Productos de Tofen"
      title='Apps <span class="gradient-text">listas para usar</span>'
      subtitle="Sistemas que ya construimos y que tu negocio puede empezar a usar hoy."
    />

    <article class="card card-static glow-border lg:grid lg:grid-cols-[1fr_1.4fr] lg:items-center" data-reveal>
      <div class="flex flex-col p-8 sm:p-10">
        <span class="pill self-start">Disponible</span>
        <h3 class="mt-5 font-display text-3xl font-bold tracking-tight text-heading sm:text-4xl">{ERP.name}</h3>
        <p class="mt-3 text-text-muted">{ERP.tagline}</p>

        <ul class="mt-8 space-y-5">
          {
            ERP.modules.map((module) => (
              <li class="flex gap-4">
                <div class="icon-badge icon-badge-sm">
                  <Icon name={module.icon} />
                </div>
                <div>
                  <p class="font-semibold text-heading">{module.name}</p>
                  <p class="mt-0.5 text-sm leading-relaxed text-text-muted">{module.description}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={waLink(ERP.ctaMessage)} target="_blank" rel="noopener">
            Pedir una demo
            <Icon name="arrow-right" />
          </a>
          {
            ERP.demoUrl && (
              <a class="btn btn-ghost" href={ERP.demoUrl} target="_blank" rel="noopener">
                <Icon name="play" />
                Ver video completo
              </a>
            )
          }
        </div>
      </div>

      <div class="px-4 pb-4 sm:px-8 sm:pb-8 lg:py-8 lg:pr-8 lg:pl-0">
        <VideoFrame src={ERP.video} poster={ERP.poster} label={ERP.name} />
      </div>
    </article>

    <div class="card card-dashed card-static mt-5 flex flex-col items-center p-8 text-center" data-reveal>
      <div class="icon-badge icon-badge-sm">
        <Icon name="sparkles" />
      </div>
      <p class="mt-4 font-display text-lg font-semibold text-heading">Más productos en camino</p>
      <p class="mt-1 max-w-md text-sm text-text-muted">
        Estamos preparando nuevas apps para negocios. ¿Tienes una idea? Escríbenos y la construimos juntos.
      </p>
    </div>
  </div>
</section>
